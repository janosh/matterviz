    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate-path": "^2.0.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "4.1.11",
    "@wooorm/starry-night": "^3.11.0",
    "happy-dom": "^20.13.2",
    "knip": "^6.34.0",
    "mdsvex": "^0.12.8",
    "pagefind": "^1.5.2",
    "publint": "^0.3.24",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "svelte": "^5.48.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.0",
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "svelte.config.ts",
          "src/site/**/*.{js,ts,svelte}",
          "src/scripts/capture-screenshots.mjs",
          "src/scripts/fetch-elem-images.mjs",
          "src/lib/scene/three-compat.ts"
        ],
        "paths": {
          "$lib": [
            "./src/lib"
          ],
          "$lib/*": [
            "./src/lib/*"
          ],
          "$site": [
            "./src/site"
          ],
          "$site/*": [
            "./src/site/*"
          ]
        },
        "ignore": [
          ".venv/**",
          "extensions/anywidget/**"
        ]
      },
      "extensions/vscode": {
        "entry": [
          "src/extension.ts"
        ],
        "paths": {
          "$lib": [
            "../../src/lib"
          ],
          "$lib/*": [
            "../../src/lib/*"
          ]
        }
      },
      "extensions/jupyterlab": {
        "entry": [
          "src/index.ts"
        ],
        "ignoreDependencies": [
          "@jupyterlab/builder",
          "@spglib/moyo-wasm",
          "process"
        ],
        "paths": {
          "$lib": [
            "../../src/lib"
          ],
          "$lib/*": [
            "../../src/lib/*"
          ]
        }
      }
    }
  }
}
