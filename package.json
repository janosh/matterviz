    "@threlte/extras": "^9.21.1",
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-contour": "^4.0.2",
    "d3-format": "^3.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate-path": "^2.3.0",
