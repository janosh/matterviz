# npm-only (pnpm ignores it). A consumer installing `github:janosh/matterviz#main` clones the repo
# and runs `npm install` there (pnpm's git fetcher falls back to npm as no lockfile is tracked) so
# the `prepare` hook can build dist/. npm's strict peer resolution rejects vite-plus's optional
# @vitest/browser-* peers pinned one patch behind vitest; pnpm resolves the same tree fine.
legacy-peer-deps=true
