{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    // To have warnings/errors of the Svelte compiler at the correct position,
    // enable source maps by default.
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // allow importing @wooorm/starry-night/style/both.css (types via its .d.css.ts) from +layout.svelte
    "allowArbitraryExtensions": true,
    "skipLibCheck": true
  },
  // extensions/ are separate packages with their own tsconfigs; anywidget has none, so its
  // entry is type-checked here through tests/vitest/anywidget-renderers.test.ts (the
  // `matterviz` alias in svelte.config.ts resolves its package imports to src/lib)
  "exclude": ["src/scripts", "extensions"]
}
